# ==============================================================================
# ENVIRONMENT CONFIGURATION - HOSTEL FOOD MANAGEMENT SYSTEM
# ==============================================================================

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_food_attendance_db?retryWrites=true&w=majority

# Or for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/hostel_food_attendance_db

# JWT Security
# Generate a random 256-bit or 512-bit string for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Backend Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (leave blank for Vite proxy in development)
# VITE_API_BASE_URL=http://localhost:8080
